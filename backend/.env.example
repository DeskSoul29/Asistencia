# Copia este archivo como .env (NO lo subas a GitHub)

# Cadena de conexión de Atlas (usuario de la app, no el Atlas Admin)
MONGODB_URI="mongodb+srv://USUARIO:CONTRASEÑA@asistencia.sfbizfu.mongodb.net/?retryWrites=true&w=majority&appName=asistencia"
DB_NAME=asistencia

# Texto largo y aleatorio para firmar las sesiones
# (genéralo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Contraseñas de acceso a cada página
ADMIN_PASSWORD=clave-del-administrador
ASISTENTE_PASSWORD=clave-del-asistente

# Dominio(s) de GitHub Pages autorizados, separados por coma (sin la ruta del repo)
ALLOWED_ORIGINS=https://TU-USUARIO.github.io,http://localhost:5500
